# Copy to .env and fill in. Every setting can also be passed as an environment variable.

# ── Groq ────────────────────────────────────────────────────────────────
# Create the key inside your Groq organization (console.groq.com → API Keys);
# the key decides which organization is billed.
RFP_GROQ_API_KEY=
RFP_GROQ_ORG_ID=org_01m1z15c06e9eb2bgctzvbf416
RFP_LLM_FRONTIER_MODEL=openai/gpt-oss-120b
RFP_LLM_FAST_MODEL=openai/gpt-oss-20b
# Move an agent between tiers, e.g. {"product_fit": "fast"}
RFP_LLM_ROUTE_OVERRIDES={}
RFP_LLM_REASONING_EFFORT_FRONTIER=medium
RFP_LLM_REASONING_EFFORT_FAST=low
# Client-side ceilings per model. Set these to your organization's limits
# (console.groq.com → Settings → Limits). Defaults match the lowest tier.
RFP_LLM_RATE_LIMITS={"openai/gpt-oss-120b": {"rpm": 30, "tpm": 8000}, "openai/gpt-oss-20b": {"rpm": 30, "tpm": 8000}}
RFP_LLM_RATE_LIMIT_MAX_WAIT_S=90
# true = heuristic fallbacks when the model is unavailable (local development only)
RFP_LLM_ALLOW_DEGRADED=false

# ── Storage ─────────────────────────────────────────────────────────────
RFP_DATABASE_URL=postgresql+psycopg://localhost:5432/proposal_platform
RFP_REDIS_URL=redis://localhost:6379/0
RFP_REDIS_REQUIRED=false

# ── Caching ─────────────────────────────────────────────────────────────
RFP_CACHE_ENABLED=true
RFP_CACHE_SECTION_TTL_S=604800
RFP_CACHE_LLM_TTL_S=86400

# ── Domain ──────────────────────────────────────────────────────────────
# A file name in configs/domain_profiles/ (without .yaml)
RFP_DEFAULT_PROFILE=default

# ── API ─────────────────────────────────────────────────────────────────
RFP_ENVIRONMENT=development
# Comma-separated; when set, every request needs an X-API-Key header
RFP_API_KEYS=
RFP_API_RATE_LIMIT_PER_MINUTE=60
RFP_CORS_ORIGINS=http://localhost:5173,http://localhost:8501
RFP_LOG_LEVEL=INFO
RFP_LOG_JSON=false

# ── Streamlit UI ────────────────────────────────────────────────────────
RFP_API_BASE_URL=http://localhost:8000/api
# Must be one of RFP_API_KEYS when API keys are enabled
RFP_UI_API_KEY=

# ── Accounts ────────────────────────────────────────────────────────────
# true = the web app shows the login page and every API route needs a signed-in session (or an API key)
RFP_AUTH_REQUIRED=false
# Signs session cookies. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
RFP_AUTH_SECRET=
RFP_AUTH_ALLOW_SIGNUP=true

# ── Vercel + Supabase ───────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543), driver psycopg:
#   RFP_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local embeddings need torch, which does not fit in a Vercel function. Use an OpenAI-compatible endpoint:
RFP_EMBEDDING_PROVIDER=local
RFP_EMBEDDING_API_URL=
RFP_EMBEDDING_API_KEY=
# Comma-separated emails that can see every user's runs (everyone else sees only their own)
RFP_ADMIN_EMAILS=

# ── Email confirmation (one-time code at sign-up) ───────────────────────
# log = print the code in the server log (local dev only). Production needs smtp or resend.
RFP_MAIL_PROVIDER=log
RFP_MAIL_FROM=
# smtp: any provider (Gmail app password, SES, Brevo...)
RFP_SMTP_HOST=
RFP_SMTP_PORT=587
RFP_SMTP_USER=
RFP_SMTP_PASSWORD=
# resend: https://resend.com (free tier available)
RFP_RESEND_API_KEY=

# ── Authenticator-app two-step sign-in ──────────────────────────────────
# Encrypts stored authenticator secrets. Set it once and keep it: changing it disconnects every
# enrolled authenticator app. Leave empty to fall back to RFP_AUTH_SECRET (then rotate neither lightly).
RFP_MFA_KEY=

# ── Sign in with Google (console.cloud.google.com → Credentials → OAuth client ID, type Web) ──
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
RFP_GOOGLE_CLIENT_ID=
RFP_GOOGLE_CLIENT_SECRET=
# Optional; derived from the request when empty
RFP_PUBLIC_URL=
